{
  "name": "aksora",
  "version": "0.14.10",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:3001": "next dev -p 3001",
    "build": "next build",
    "test": "node scripts/test-relevant.mjs",
    "test:all": "vitest run",
    "test:changed": "node scripts/test-relevant.mjs",
    "precheck": "pnpm lint && tsc --noEmit && next build",
    "ci:check": "pnpm test:all && pnpm precheck",
    "test:watch": "vitest",
    "start": "next start",
    "lint": "eslint .",
    "db:init": "echo 'Schema auto-created on first app access'",
    "db:reset": "node --experimental-strip-types scripts/reset-db.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:backup": "node scripts/backup.mjs",
    "graphify:update": "python -m graphify update . --force",
    "graphify:query": "python -m graphify query",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "check:api-guards": "node scripts/check-api-guards.mjs",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "db:health": "node scripts/db-schema-health.mjs",
    "db:storage": "node scripts/db-storage-stats.mjs",
    "db:smoke-crud": "node scripts/db-smoke-crud.mjs",
    "db:health:ci": "pnpm db:health",
    "analyze": "set ANALYZE=true& next build",
    "domain:setup": "node scripts/setup-domain.mjs",
    "sicmundus:agent": "node scripts/sicmundus-agent.mjs",
    "sicmundus:same": "node scripts/sicmundus-agent.mjs --reuse",
    "sicmundus:fill": "node scripts/sicmundus-agent.mjs --fill-gaps",
    "sicmundus:cron": "node scripts/sicmundus-cron.mjs",
    "runner:start": "node scripts/ai-runner.mjs",
    "mcp": "node scripts/aksora-mcp.mjs",
    "prepare": "node scripts/git-hooks/install.mjs",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "hooks:install": "node scripts/git-hooks/install.mjs",
    "worktree:add": "node scripts/worktree.mjs add",
    "worktree:list": "node scripts/worktree.mjs list",
    "worktree:remove": "node scripts/worktree.mjs remove"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.14.26",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "next": "^16.4.6",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@midscene/web": "1.18.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fast-check": "^4.10.2",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}